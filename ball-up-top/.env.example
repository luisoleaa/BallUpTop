# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, used exclusively by scripts/ (backfill/check scripts) -- never
# imported by app code. Keep this out of any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# balldontlie.io API key, used only by scripts/backfill*.ts
BALL_DONT_LIE_API_KEY=
BASE_URL=https://api.balldontlie.io

# Public site URL, used for metadataBase/OpenGraph/robots.txt/sitemap.xml.
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=
