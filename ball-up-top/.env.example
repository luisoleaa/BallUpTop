# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/ (backfill/check scripts) AND by
# lib/supabase/service.ts, which lib/match-status-cache.ts's
# syncMatchStatusCache() uses to write public.match_status_cache -- the one
# live-request-path use of this key, so it must be set in your production
# host's env vars too, not just .env.local. Never import lib/supabase/
# service.ts anywhere a client-supplied value could reach it, and keep this
# key itself out of any client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# balldontlie.io API key, used only by scripts/backfill*.ts
BALL_DONT_LIE_API_KEY=
BASE_URL=https://api.balldontlie.io

# Public site URL, used for metadataBase/OpenGraph/robots.txt/sitemap.xml.
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=
